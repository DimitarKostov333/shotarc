# Copy to deploy/shotarc.env (gitignored). Shared by the app build and the server.
# Generate secrets with:  head -c 24 /dev/urandom | base64 | tr -d '/+=' | head -c 32
INGEST_KEY=
# Read-only JSON API for scripts, sent as the X-Dashboard-Key header. Not a way into /dashboard.
DASHBOARD_KEY=
# Signs the login cookie. Leave it empty and every restart logs everyone out.
SESSION_SECRET=
# Seeds the first dashboard login on a fresh box (change the password afterwards with create-user.js).
ADMIN_USER=
ADMIN_PASSWORD=
